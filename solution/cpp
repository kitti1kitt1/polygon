#include <iostream>
#include <vector>
using namespace std;

class Solution
{
public:
    int minPatches(vector<int> &nums, int n)
    {
        ios_base::sync_with_stdio(0);
        long long currentSum = 1; // Наименьшее число, которое пока не может быть представлено
        int patches = 0, index = 0; // patches - количество добавленных чисел, index - текущий индекс в массиве nums

        while (currentSum <= n)
        {
            // Если текущее число из nums в пределах currentSum, оно добавляется к диапазону
            if (index < nums.size() && nums[index] <= currentSum)
            {
                currentSum += nums[index]; // Добавляем nums[index] к currentSum
                index++;
            }
            else
            {
                // Если число из nums не покрывает диапазон, добавляем currentSum как "заплатку"
                currentSum += currentSum; // Расширяем диапазон до currentSum * 2 - 1
                patches++;
            }
        }
        return patches;
    }
};

int main()
{
    Solution solution;

    // Тестовые данные
    vector<pair<vector<int>, int>> testCases = {
        {{1, 3}, 6},
        {{1, 5, 10}, 20},
        {{}, 7},
        {{1, 2, 2}, 5}
    };

    for (const auto &test : testCases)
    {
        const auto &nums = test.first;
        int n = test.second;
        cout << "Для массива: [";
        for (size_t i = 0; i < nums.size(); i++)
        {
            cout << nums[i] << (i + 1 < nums.size() ? ", " : "");
        }
        cout << "] и n = " << n << ", минимальное количество заплаток: " << solution.minPatches(nums, n) << endl;
    }

    return 0;
}
